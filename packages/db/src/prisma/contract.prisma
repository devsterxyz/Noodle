// use prisma-8

model User{
  id          String     @id @default(uuid())
  email       String
  password    String
  name        String
  avatar      String
}

model Room{
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  createdAt   DateTime  @default(now())
}

model Chat{
  id        Int       @id  @default(autoincrement())
  message   String
  userId    String
}